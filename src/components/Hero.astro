---
import MetaStrip from './case/MetaStrip.astro';

interface Props {
  brand?: string;
  line?: string;
  support?: string;
}

const {
  brand = 'unnamed',
  line = 'Product design for moments that need clarity.',
  support = 'Selected product work. One case study is up; more are on the way.',
} = Astro.props;

const meta = [
  { label: 'Practice', value: 'Product design' },
  { label: 'Focus', value: 'Outstation booking' },
  { label: 'Case study', value: 'Clarity' },
  { label: 'Year', value: '2026' },
];
---

<section class="hero" aria-labelledby="brand">
  <div class="hero__center">
    <p class="eyebrow motion-rise"><i></i>UX portfolio</p>
    <h1 id="brand" class="hero__brand motion-rise motion-delay-1" transition:name="hero-brand">
      <span class="hero__word">{brand}</span>
    </h1>
    <p class="hero__line motion-rise motion-delay-2">
      {line}
    </p>
    <p class="hero__support motion-rise motion-delay-2">{support}</p>
    <div class="hero__actions motion-rise motion-delay-3">
      <a class="btn btn--ink" href="#work">View work</a>
      <a class="btn btn--hair" href="/projects/clarity">Clarity</a>
    </div>
  </div>

  <MetaStrip items={meta} />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding-top: 90px;
  }

  .hero__center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(18px, 4vw, 44px);
  }

  .hero__brand {
    font-weight: 800;
    font-size: var(--type-brand);
    line-height: 0.82;
    letter-spacing: -0.045em;
  }

  .hero__word {
    display: block;
  }

  .hero__line {
    margin-top: clamp(20px, 3.4svh, 34px);
    font-size: var(--type-hero);
    font-weight: 500;
    line-height: 1.5;
    max-width: 36ch;
    color: var(--color-body);
  }

  .hero__support {
    margin-top: 0.75rem;
    max-width: 36ch;
    color: var(--color-fog);
    font-size: 0.95rem;
  }

  .hero__actions {
    margin-top: clamp(22px, 3.6svh, 38px);
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
