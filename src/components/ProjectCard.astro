---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  year: number;
  role: string;
  tags: string[];
  href: string;
  status: 'stub' | 'published';
  cover?: ImageMetadata;
  index?: number;
}

const { title, summary, year, role, tags, href, status, cover, index = 0 } = Astro.props;
const delayClass = `motion-delay-${Math.min(index + 1, 3)}`;
---

<article class:list={['project-card', 'motion-rise', delayClass]}>
  <a class="project-card__link" href={href}>
    <div class="project-card__media" transition:name={`cover-${href}`}>
      {
        cover ? (
          <Image
            src={cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(max-width: 720px) 100vw, 40vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            class="project-card__img"
          />
        ) : (
          <div class="project-card__fallback" aria-hidden="true" />
        )
      }
      {
        status === 'stub' && (
          <span class="project-card__status">Coming soon</span>
        )
      }
    </div>
    <div class="project-card__body">
      <p class="project-card__meta">
        <span>{year}</span>
        <span aria-hidden="true">·</span>
        <span>{role}</span>
      </p>
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__summary">{summary}</p>
      {
        tags.length > 0 && (
          <p class="project-card__tags">
            {tags.join(' / ')}
          </p>
        )
      }
    </div>
  </a>
</article>

<style>
  .project-card__link {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 720px) {
    .project-card__link {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--space-5);
      align-items: center;
    }
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-lift);
    border-radius: clamp(16px, 2.2vw, 30px);
    box-shadow: var(--shadow-media);
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-med) var(--ease-out);
  }

  .project-card__fallback {
    width: 100%;
    height: 100%;
    background: var(--gradient-plate-fallback), var(--color-lift);
  }

  .project-card__status {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-lime);
    padding: 7px 12px;
    border-radius: 100px;
  }

  .project-card__meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-card__title {
    font-weight: 800;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
    margin-top: var(--space-2);
    line-height: 1.02;
  }

  .project-card__summary {
    margin-top: var(--space-2);
    color: var(--color-foam-muted);
    max-width: 38ch;
  }

  .project-card__tags {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  .project-card__link:hover .project-card__img,
  .project-card__link:focus-visible .project-card__img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__img {
      transition: none;
    }
  }
</style>
