---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<section class="work site-shell" id="work" aria-labelledby="work-heading">
  <header class="work__header motion-fade">
    <p class="kicker">( Selected )</p>
    <h2 id="work-heading" class="work__heading">
      Selected
      <span class="out">work.</span>
    </h2>
    <p class="work__lede">A published case study, and earlier stories still being written.</p>
  </header>

  <ul class="project-list" role="list">
    {
      projects.map((project, index) => (
        <li>
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            year={project.data.year}
            role={project.data.role}
            tags={project.data.tags}
            href={`/projects/${project.id}`}
            status={project.data.status}
            cover={project.data.cover}
            index={index}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    padding-block: clamp(70px, 10vw, 150px);
  }

  .work__header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(40px, 6vw, 70px);
    max-width: 18ch;
  }

  .work__heading {
    font-weight: 800;
    font-size: var(--type-title);
    letter-spacing: -0.04em;
    line-height: 1.02;
    display: grid;
  }

  .work__lede {
    color: var(--color-body);
    max-width: 36ch;
    font-weight: 500;
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
  }

  .project-list li {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }
</style>
