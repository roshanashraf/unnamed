---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<section class="work site-shell" id="work" aria-labelledby="work-heading">
  <header class="work__header motion-fade">
    <h2 id="work-heading" class="work__heading">Selected work</h2>
    <p class="work__lede">Three placeholders for Phase 1 — case studies to follow.</p>
  </header>

  <ul class="project-list" role="list">
    {
      projects.map((project, index) => (
        <li>
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            year={project.data.year}
            role={project.data.role}
            tags={project.data.tags}
            href={`/projects/${project.id}`}
            status={project.data.status}
            cover={project.data.cover}
            index={index}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    padding-block: var(--space-6) var(--space-7);
  }

  .work__header {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    max-width: 40ch;
  }

  .work__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .work__lede {
    color: var(--color-foam-muted);
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
  }

  .project-list li {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }
</style>
