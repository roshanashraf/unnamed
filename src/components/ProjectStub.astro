---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Prose from './Prose.astro';

interface Props {
  id: string;
  title: string;
  summary: string;
  year: number;
  role: string;
  tags: string[];
  isStub: boolean;
  cover?: ImageMetadata;
  Content?: AstroComponentFactory;
}

const { id, title, summary, year, role, tags, isStub, cover, Content } = Astro.props;
---

<article class="project">
  <header class="project__header motion-rise">
    <p class="project__meta">
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <span>{role}</span>
      {
        isStub && (
          <>
            <span aria-hidden="true">·</span>
            <span>Coming soon</span>
          </>
        )
      }
    </p>
    <h1 class="home-heading" transition:name={`title-${id}`}>
      {title}
    </h1>
    <div class="home-rule"></div>
    <p class="project__summary motion-rise motion-delay-1">{summary}</p>
    {
      tags.length > 0 && (
        <p class="project__tags motion-fade motion-delay-2">{tags.join(' / ')}</p>
      )
    }
  </header>

  {
    cover && (
      <div class="project__cover motion-fade motion-delay-1" transition:name={`cover-/projects/${id}`}>
        <Image
          src={cover}
          alt=""
          widths={[720, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 72rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }

  <div class="project__body motion-rise motion-delay-2">
    {
      isStub ? (
        <Prose>
          <p>
            This case study is a Phase 1 stub. Narrative, process, and outcomes will land here without
            changing routes or the content model.
          </p>
        </Prose>
      ) : (
        Content && (
          <Prose>
            <Content />
          </Prose>
        )
      )
    }
  </div>

  <p class="project__back">
    <a class="home-back" href="/#work">Work</a>
  </p>
</article>

<style>
  .project__header {
    margin-bottom: var(--space-5);
  }

  .project__meta,
  .project__summary,
  .project__tags,
  .project__body {
    color: var(--color-home-muted);
    line-height: 1.625;
  }

  .project__summary,
  .project__tags {
    margin-top: var(--space-4);
  }

  .project__cover {
    margin-block: var(--space-5);
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-home-plate);
  }

  .project__cover :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project__body {
    margin-bottom: var(--space-5);
  }

  .project__body :global(.prose) {
    max-width: none;
    color: var(--color-home-muted);
    line-height: 1.625;
  }

  .project__back {
    margin-top: 72px;
  }
</style>
