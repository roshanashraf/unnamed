---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Prose from './Prose.astro';

interface Props {
  id: string;
  title: string;
  summary: string;
  year: number;
  role: string;
  tags: string[];
  isStub: boolean;
  cover?: ImageMetadata;
  Content?: AstroComponentFactory;
}

const { id, title, summary, year, role, tags, isStub, cover, Content } = Astro.props;
---

<article class="project site-shell">
  <header class="project__header motion-rise">
    <p class="project__meta">
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <span>{role}</span>
      {
        isStub && (
          <>
            <span aria-hidden="true">·</span>
            <span>Coming soon</span>
          </>
        )
      }
    </p>
    <h1 class="project__title" transition:name={`title-${id}`}>
      {title}
    </h1>
    <p class="project__summary motion-rise motion-delay-1">{summary}</p>
    {
      tags.length > 0 && (
        <p class="project__tags motion-fade motion-delay-2">{tags.join(' / ')}</p>
      )
    }
  </header>

  {
    cover && (
      <div class="project__cover motion-fade motion-delay-1" transition:name={`cover-/projects/${id}`}>
        <Image
          src={cover}
          alt=""
          widths={[720, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 72rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }

  <div class="project__body motion-rise motion-delay-2">
    {
      isStub ? (
        <Prose>
          <p>
            This case study is a Phase 1 stub. Narrative, process, and outcomes will land here without
            changing routes or the content model.
          </p>
        </Prose>
      ) : (
        Content && (
          <Prose>
            <Content />
          </Prose>
        )
      )
    }
  </div>

  <p class="project__back">
    <a href="/#work">← All work</a>
  </p>
</article>

<style>
  .project {
    padding-block: calc(90px + var(--space-5)) var(--space-7);
  }

  .project__header {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
    margin-bottom: var(--space-5);
  }

  .project__meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project__title {
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .project__summary {
    font-size: var(--type-hero);
    line-height: 1.3;
    max-width: 28ch;
  }

  .project__tags {
    color: var(--color-deep);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project__cover {
    margin-bottom: var(--space-5);
    overflow: hidden;
    border-radius: clamp(16px, 2.2vw, 30px);
    background: var(--color-lift);
    box-shadow: var(--shadow-media);
  }

  .project__cover :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project__body {
    margin-bottom: var(--space-6);
  }

  .project__back a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }

  .project__back a:hover {
    opacity: 1;
  }
</style>
