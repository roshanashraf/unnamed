</div>

<style>
  .prose {
    max-width: 62ch;
    color: var(--color-foam-muted);
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-display);
    color: var(--color-foam);
    letter-spacing: -0.02em;
    margin-top: 1.6em;
    margin-bottom: 0.5em;
  }

  .prose :global(a) {
    color: var(--color-accent);
  }
</style>
