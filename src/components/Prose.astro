---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<div class:list={['prose', wide && 'prose--wide']}>
  <slot />
</div>

<style>
  .prose {
    max-width: 62ch;
    color: var(--color-foam-muted);
  }

  .prose--wide {
    max-width: 40rem;
    display: grid;
    gap: 1.1em;
    text-wrap: pretty;
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .prose--wide :global(p + p) {
    margin-top: 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 1.6em;
    margin-bottom: 0.5em;
  }

  .prose :global(a) {
    color: var(--color-deep);
  }

  .prose :global(strong) {
    color: var(--color-ink);
    font-weight: 700;
  }

  .prose--wide :global(strong) {
    color: var(--color-foam);
    font-weight: 650;
  }
</style>
