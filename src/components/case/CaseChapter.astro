---
interface Props {
  index: string;
  label: string;
  title: string;
  id: string;
}

const { index, label, title, id } = Astro.props;
---

<section class="case-chapter" aria-labelledby={id}>
  <div class="case-chapter__shell site-shell">
    <header class="case-chapter__head">
      <p class="case-chapter__index"><span>{index}</span> {label}</p>
      <h2 id={id}>{title}</h2>
    </header>
    <slot />
  </div>
  <slot name="band" />
</section>

<style>
  .case-chapter {
    padding-top: var(--space-7);
  }

  .case-chapter__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    min-width: 0;
  }

  .case-chapter__head > * {
    min-width: 0;
    max-width: 100%;
  }

  .case-chapter__index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  .case-chapter__index span {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    letter-spacing: -0.05em;
    color: var(--color-ink);
    line-height: 1;
    margin-bottom: 10px;
    text-transform: none;
  }

  .case-chapter__head h2 {
    text-wrap: balance;
    font-weight: 800;
    font-size: clamp(1.7rem, 3.8vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    max-width: 18ch;
  }

  .case-chapter :global(.moves),
  .case-chapter :global(.steps),
  .case-chapter :global(.signal),
  .case-chapter :global(.idle),
  .case-chapter :global(.jump) {
    min-width: 0;
  }

  .case-chapter :global(.moves),
  .case-chapter :global(.steps) {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .case-chapter :global(.moves li),
  .case-chapter :global(.steps li) {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .case-chapter :global(.moves li > span),
  .case-chapter :global(.steps li > span) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  .case-chapter :global(.moves p),
  .case-chapter :global(.steps p) {
    color: var(--color-foam-muted);
    max-width: 42rem;
  }

  .case-chapter :global(.steps h3) {
    font-weight: 800;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    letter-spacing: -0.035em;
    margin-bottom: 0.35rem;
  }

  .case-chapter :global(.signal) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
    color: var(--color-foam);
  }

  .case-chapter :global(.signal__value) {
    font-family: var(--font-display);
    font-weight: 720;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--color-accent);
  }

  .case-chapter :global(.idle) {
    margin-top: var(--space-5);
    padding: var(--space-5) var(--space-4);
    border: 1px dashed var(--color-line);
    border-radius: 0.15rem;
    display: grid;
    gap: 0.4rem;
  }

  .case-chapter :global(.idle__kicker) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  .case-chapter :global(.idle__title) {
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: rgba(var(--color-ink-rgb), 0.28);
  }

  .case-chapter :global(.idle__copy) {
    color: var(--color-foam-muted);
  }

  .case-chapter :global(.jump) {
    margin-top: var(--space-5);
    padding: var(--space-5) var(--space-4);
    background: var(--color-lift);
    border-radius: clamp(16px, 2.2vw, 30px);
    box-shadow: var(--shadow-media-soft);
    display: grid;
    gap: 0.35rem;
  }

  .case-chapter :global(.jump figcaption) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.5;
  }

  .case-chapter :global(.jump__sum) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.8rem;
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.04em;
    color: var(--color-body);
  }

  .case-chapter :global(.jump__op) {
    color: var(--color-orange);
  }

  .case-chapter :global(.jump__total) {
    font-weight: 800;
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  @media (min-width: 860px) {
    .case-chapter__shell {
      display: grid;
      grid-template-columns: minmax(150px, 230px) minmax(0, 1fr);
      column-gap: clamp(18px, 3vw, 46px);
      align-items: start;
    }

    .case-chapter__head {
      display: contents;
    }

    .case-chapter__index {
      grid-column: 1;
      grid-row: 1;
    }

    .case-chapter__head h2,
    .case-chapter__shell > :global(.prose),
    .case-chapter__shell > :global(.case-plate-pair),
    .case-chapter__shell > :global(.moves),
    .case-chapter__shell > :global(.steps),
    .case-chapter__shell > :global(.idle),
    .case-chapter__shell > :global(.jump) {
      grid-column: 2;
    }

    .case-chapter__head h2 {
      margin-bottom: 0.35em;
    }
  }

  @media (min-width: 720px) {
    .case-chapter :global(.moves li),
    .case-chapter :global(.steps li) {
      grid-template-columns: 8rem 1fr;
    }
  }

  @media (max-width: 719px) {
    .case-chapter__head h2 {
      font-size: clamp(1.85rem, 8.6vw, 2.55rem);
      max-width: 100%;
    }

    .case-chapter :global(.moves li),
    .case-chapter :global(.steps li) {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
