---
interface Props {
  year: number;
  role: string;
  guideLine: string;
}

const { year, role, guideLine } = Astro.props;
---

<header class="case-hero" data-guide={guideLine} data-guide-mode="hero">
  <h1 class="case-title">Clarity</h1>
  <p class="case-lede">Make every booking self-explanatory.</p>
  <p class="case-body">
    Clear trip type, route, price, inclusions, and policies — across every touchpoint.
  </p>
  <p class="case-meta">Outstation cabs · MakeMyTrip · {role} · {year}</p>
</header>

<style>
  .case-hero {
    display: grid;
    gap: var(--space-4);
  }

  .case-lede {
    margin-top: var(--space-2);
  }
</style>
