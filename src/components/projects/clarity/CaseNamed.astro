---
interface Props {
  guideLine: string;
}

const { guideLine } = Astro.props;
---

<section
  class="case-named story-beat"
  aria-labelledby="named-title"
  data-guide={guideLine}
  data-guide-mode="contact"
>
  <h2 id="named-title" class="case-section">The booking says it out loud.</h2>
  <ol class="case-named__list" role="list">
    <li>
      <p class="case-subhead">Trip type.</p>
      <p class="case-body">Dropped off, or the cab stays.</p>
    </li>
    <li>
      <p class="case-subhead">Route.</p>
      <p class="case-body">The road in the price. Not live yet — no data.</p>
    </li>
    <li>
      <p class="case-subhead">Policies.</p>
      <p class="case-body">One-way and round trip, written apart.</p>
    </li>
    <li>
      <p class="case-subhead">Sightseeing.</p>
      <p class="case-body">Included, or an add-on.</p>
    </li>
    <li>
      <p class="case-subhead">Luggage.</p>
      <p class="case-body">A best fit, not only a fare.</p>
    </li>
    <li>
      <p class="case-subhead">The flight.</p>
      <p class="case-body">Tracked through to pickup.</p>
    </li>
  </ol>
</section>

<style>
  .case-named {
    margin-top: var(--case-gap);
  }

  .case-named__list {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
    max-width: 42ch;
  }

  .case-named__list li {
    display: grid;
    gap: 0.35rem;
  }
</style>
