---
interface NextProject {
  href: string;
  title: string;
}

interface Props {
  next: NextProject | null;
}

const { next } = Astro.props;
const href = next?.href ?? '/#work';
const title = next?.title ?? 'All work';
const label = next ? 'Next' : 'Back';
---

<nav class="case-next story-beat" aria-label="Continue">
  <p class="case-metric__group-label">{label}</p>
  <a class="case-next__link" href={href}>
    <span class="case-subhead">{title}</span>
  </a>
</nav>

<style>
  .case-next {
    margin-top: var(--case-gap);
  }

  .case-next__link {
    display: block;
    margin-inline: -16px;
    margin-top: var(--space-3);
    border-radius: 12px;
    padding: 14px 16px;
    text-decoration: none;
    color: var(--color-home-ink);
    transition: background-color 150ms var(--ease-soft);
  }

  .case-next__link:hover,
  .case-next__link:focus-visible {
    background: var(--color-home-hover);
  }
</style>
