---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — unnamed" description="This page does not exist.">
  <section class="missing">
    <p class="eyebrow"><i></i>404</p>
    <h1 class="missing__title">
      Lost the
      <span class="out">thread.</span>
    </h1>
    <p class="missing__copy">That route isn’t part of this portfolio.</p>
    <a class="btn btn--ink" href="/">Back home</a>
  </section>
</BaseLayout>

<style>
  .missing {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
    padding: 120px clamp(18px, 4vw, 44px);
  }

  .missing__title {
    font-weight: 800;
    font-size: clamp(3rem, 11vw, 8rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    display: grid;
  }

  .missing__copy {
    color: var(--color-body);
    max-width: 36ch;
  }
</style>
