---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectStub from '../../components/ProjectStub.astro';
import { getProjectView } from '../../projects/registry';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );
  return projects.map((project, index) => {
    const following = projects[index + 1];
    return {
      params: { slug: project.id },
      props: {
        project,
        next: following
          ? { href: `/projects/${following.id}`, title: following.data.title }
          : null,
      },
    };
  });
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const title = project.data.seo?.title ?? `${project.data.title} — unnamed`;
const description = project.data.seo?.description ?? project.data.summary;
const isStub = project.data.status === 'stub';
const View = getProjectView(project.id);
---

<BaseLayout title={title} description={description}>
  {
    View ? (
      <View year={project.data.year} role={project.data.role} next={next} />
    ) : (
      <ProjectStub
        id={project.id}
        title={project.data.title}
        summary={project.data.summary}
        year={project.data.year}
        role={project.data.role}
        tags={project.data.tags}
        isStub={isStub}
        cover={project.data.cover}
        Content={isStub ? undefined : Content}
      />
    )
  }
</BaseLayout>
